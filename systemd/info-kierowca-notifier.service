[Unit]
Description=Check info-kierowca.pl for exam slots (read-only, notification only)

[Service]
Type=oneshot
# The source checkout is managed with uv. Run `uv sync` in WorkingDirectory before enabling this
# unit; --no-sync makes a missing/stale environment fail visibly instead of changing it in a timer.
# If your clone lives elsewhere, update WorkingDirectory.
Environment="PATH=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin"
WorkingDirectory=%h/infokierowca
ExecStart=/usr/bin/env uv run --locked --no-sync python -m info_kierowca_notifier.notifier
