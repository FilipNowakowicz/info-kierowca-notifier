[Unit]
Description=Local read-only dashboard for info-kierowca notifier (127.0.0.1 only)

[Service]
Type=simple
# The source checkout is managed with uv. Run `uv sync` in WorkingDirectory before enabling this
# unit; --no-sync makes a missing/stale environment fail visibly instead of changing it in a service.
# If your clone lives elsewhere, update WorkingDirectory.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/infokierowca
ExecStart=/usr/bin/env uv run --locked --no-sync python dashboard_server.py
Restart=on-failure

[Install]
WantedBy=default.target
